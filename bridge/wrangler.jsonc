{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyotp-bridge",
  "main": "src/worker.ts",
  // The newest date the test pool's bundled runtime accepts.
  "compatibility_date": "2026-08-22",

  // Bridge 2 (DECISIONS D17). Reached only by its own name: the workers.dev
  // address is filtered in Iran, where the Host is.
  "workers_dev": false,
  "routes": [{ "pattern": "easyotp.cfworker.rhinocloud.ir", "custom_domain": true }],

  // One Durable Object per box, holding sealed messages until they are
  // collected (D16). SQLite-backed, which is the only kind the free plan runs.
  "durable_objects": {
    "bindings": [
      { "name": "BOX", "class_name": "BoxObject" },
      { "name": "PAIR", "class_name": "PairObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoxObject"] },
    { "tag": "v2", "new_sqlite_classes": ["PairObject"] }
  ],

  "observability": { "enabled": true },

  "vars": {
    // A Durable Object is billed for the time a request is held open, so the
    // hold here is shorter than on bridge 1.
    "POLL_HOLD_SECONDS": "25",
    // The public half of the push signing key (DECISIONS D30). The Receiver
    // carries the same value. The private half is the secret VAPID_PRIVATE_JWK.
    "VAPID_PUBLIC_KEY": "BLmXanjp4rwi6T8Ri5hMKukG6Lcads7FZ8anl_Vi4DoVeNPgH0FAvCYkwXGdaGeyv_q0-2TIB_Tvz8deXCUpMgk",
    // Who a push service may contact about this application. A place, not a person.
    "VAPID_SUBJECT": "https://github.com/amir-salmani/easyotp"
  }
}
