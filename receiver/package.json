{
  "name": "easyotp-receiver",
  "version": "0.3.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fake-host": "esbuild tools/fake-host.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist-tools/fake-host.mjs && node dist-tools/fake-host.mjs",
    "e2e": "esbuild tools/e2e.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=dist-tools/e2e.mjs && node dist-tools/e2e.mjs",
    "live-check": "esbuild tools/live-check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist-tools/live-check.mjs && node dist-tools/live-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@hpke/chacha20poly1305": "^1.8.1",
    "@hpke/core": "^1.10.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
