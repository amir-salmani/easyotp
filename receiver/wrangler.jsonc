{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyotp-receiver",
  "compatibility_date": "2026-08-22",

  // The Receiver web app: static files and nothing else. No code runs here and
  // nothing a person receives passes through it. Messages go from the bridges
  // straight to the browser.
  "workers_dev": false,
  "routes": [{ "pattern": "pwa.easyotp.rhinocloud.ir", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
